{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // El ciclo más rápido para la mascota: HMR completo, sin arrancar Electron.
      // El puente cae al sustituto de navegador, así que Ctrl+Shift+Space funciona.
      "name": "Mascot in Chrome (ng serve)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: dev:web",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      // Puntos de interrupción en electron/main.ts. Requiere `npm run build:electron`
      // y el servidor de desarrollo de Angular corriendo (npm run dev:web).
      "name": "Electron: main process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
      "runtimeArgs": [".", "--remote-debugging-port=9222"],
      "env": { "MILOPET_DEV": "1" },
      "preLaunchTask": "npm: build:electron",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Puntos de interrupción en el renderer, enganchados a la ventana de Electron ya abierta.
      "name": "Electron: renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Electron: main + renderer",
      "configurations": ["Electron: main process", "Electron: renderer"]
    }
  ]
}
